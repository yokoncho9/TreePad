<ui:FluentWindow x:Class="TreePad.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Menu_About}"
        Width="440" Height="400"
        MinWidth="380" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource GruvFg}"
        Background="{DynamicResource GruvBg}"
        FontFamily="Segoe UI Variable Text, 맑은 고딕, Malgun Gothic, sans-serif">

    <Grid Background="{DynamicResource GruvBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 타이틀바 -->
            <RowDefinition Height="*" />    <!-- 본문 내용 -->
            <RowDefinition Height="Auto" /> <!-- 하단 버튼바 -->
        </Grid.RowDefinitions>

        <!-- 타이틀바 -->
        <Border Grid.Row="0" Background="{DynamicResource GruvHeaderBg}" BorderBrush="{DynamicResource GruvBorder}" BorderThickness="0,0,0,1">
            <ui:TitleBar Title="{DynamicResource Menu_About}"
                         Foreground="{DynamicResource GruvFg}"
                         ShowMaximize="False" ShowMinimize="False" ShowClose="True"
                         Padding="12,0,0,0" Height="32" />
        </Border>

        <!-- 본문 내용 -->
        <StackPanel Grid.Row="1" Margin="28,20,28,16" VerticalAlignment="Center">
            <!-- 앱 아이콘 + 타이틀 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/TreePad;component/Assets/app.ico" Width="44" Height="44" Margin="0,0,14,0" SnapsToDevicePixels="True" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TreePad" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GruvFg}" Margin="0,0,8,0" />
                        <Border Background="{DynamicResource GruvAccentOrange}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.1" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource About_Tagline}" FontSize="12.5" Foreground="{DynamicResource GruvFgMuted}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 상세 정보 카드 -->
            <Border Background="{DynamicResource GruvPanelBg}" BorderBrush="{DynamicResource GruvBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About_Developer}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource GruvFg}" Width="80" />
                        <TextBlock Grid.Column="1" Text="yokoncho9" FontSize="12.5" Foreground="{DynamicResource GruvFg}" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About_License}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource GruvFg}" Width="80" />
                        <TextBlock Grid.Column="1" Text="MIT License" FontSize="12.5" Foreground="{DynamicResource GruvFg}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GitHub" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource GruvFg}" Width="80" />
                        <TextBlock Grid.Column="1">
                            <Hyperlink NavigateUri="https://github.com/yokoncho9/TreePad" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="{DynamicResource GruvAccentAqua}">
                                github.com/yokoncho9/TreePad
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 한 줄 설명 -->
            <TextBlock Text="{DynamicResource About_Description}"
                       FontSize="12" Foreground="{DynamicResource GruvFgMuted}"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" />
        </StackPanel>

        <!-- 하단 버튼바 -->
        <Border Grid.Row="2" Background="{DynamicResource GruvPanelBg}" BorderBrush="{DynamicResource GruvBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="{DynamicResource About_Close}" Click="OnCloseClick"
                    HorizontalAlignment="Right" MinWidth="80" Padding="16,6"
                    Background="{DynamicResource GruvBg}" BorderBrush="{DynamicResource GruvBorderStrong}"
                    Foreground="{DynamicResource GruvFg}" FontWeight="Medium" IsDefault="True" IsCancel="True" />
        </Border>
    </Grid>
</ui:FluentWindow>
