<ui:FluentWindow x:Class="TreePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TreePad.ViewModels"
        xmlns:conv="clr-namespace:TreePad.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}"
        Icon="Assets/app.ico"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource GruvFg}"
        Background="{DynamicResource GruvBg}"
        FontFamily="Segoe UI Variable Text, 맑은 고딕, Malgun Gothic, sans-serif"
        Width="1100" Height="720" MinWidth="600" MinHeight="400"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <conv:BoolToTextWrappingConverter x:Key="BoolToWrap" />
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLength" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- 🌟 포커스 시에도 절대 흰색으로 변하지 않는 순수 안티그래비티 에디터 TextBox 스타일 🌟 -->
        <Style x:Key="GruvPureEditorTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource GruvBg}" />
            <Setter Property="Foreground" Value="{StaticResource GruvFg}" />
            <Setter Property="CaretBrush" Value="{StaticResource GruvCaret}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem 템플릿 (아이콘 + 텍스트) -->
        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 아이콘: 폴더 vs 메모 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{StaticResource GruvAccentYellow}"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Foreground="{StaticResource GruvAccentAqua}"
                                   Visibility="{Binding IsFolder, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <!-- 텍스트 표시 모드 -->
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13.5"
                           Foreground="{StaticResource GruvFg}"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 인라인 이름 편집 모드 (F2) -->
                <TextBox Grid.Column="1" Text="{Binding Name, Mode=OneWay}"
                         VerticalAlignment="Center" FontSize="13" Padding="4,1"
                         Background="{StaticResource GruvBg}" Foreground="{StaticResource GruvFg}"
                         BorderBrush="{StaticResource GruvAccentOrange}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                         KeyDown="OnItemNameEditKeyDown"
                         LostFocus="OnItemNameEditLostFocus"
                         Loaded="OnItemNameEditLoaded"
                         IsVisibleChanged="OnItemNameEditIsVisibleChanged" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding CreateNewNoteCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding CreateNewFolderCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Modifiers="Alt" Key="Z" Command="{Binding ToggleWordWrapCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshTreeCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource GruvBg}">
        <Grid.RowDefinitions>
            <!-- 0: 타이틀바 영역 (Gruvbox Header) -->
            <RowDefinition Height="Auto" />
            <!-- 1: 메인 작업 공간 (트리 + 탭 에디터) -->
            <RowDefinition Height="*" />
            <!-- 2: 하단 상태 표시줄 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: TitleBar (슬림하고 날렵한 32px 헤더) -->
        <Border Grid.Row="0" Background="{StaticResource GruvHeaderBg}" BorderBrush="{StaticResource GruvBorder}" BorderThickness="0,0,0,1">
            <ui:TitleBar x:Name="AppTitleBar"
                         Title="{DynamicResource AppTitle}"
                         Foreground="{StaticResource GruvFg}"
                         ShowMaximize="True" ShowMinimize="True" ShowClose="True"
                         Padding="12,0,0,0" Height="32" />
        </Border>

        <!-- 1: 메인 2분할 영역 (트리 + 탭 에디터) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 좌측 사이드바 컬럼 (트리가 숨겨지면 폭 0으로 자동 전환) -->
                <ColumnDefinition x:Name="SidebarColumn" Width="{Binding SidebarWidth, Converter={StaticResource DoubleToGridLength}}"
                                  MinWidth="0" MaxWidth="500" />
                <!-- 분할 스플리터 -->
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <!-- 우측 메모 탭 에디터 (항상 나머지 공간 100% 차지) -->
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 패널 (트리 탐색기 - 안티그래비티 사이드바 크림 베이지) -->
            <Grid x:Name="SidebarGrid" Grid.Column="0" Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource GruvPanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 0: 트리 상단 검색창 -->
                    <RowDefinition Height="Auto" /> <!-- 1: 현재 작업 위치 바 & 최상단 선택 해제 버튼 -->
                    <RowDefinition Height="*" />    <!-- 2: 트리 뷰 -->
                </Grid.RowDefinitions>

                <!-- 0: 트리 상단 검색 바 (사이드바 접기 + 햄버거 메뉴 + 메모 검색) -->
                <Border Grid.Row="0" Padding="8,7,8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. 사이드바 접기 버튼 -->
                        <Button Grid.Column="0" ToolTip="{DynamicResource Tip_ToggleSidebar}" Command="{Binding ToggleSidebarCommand}"
                                Padding="6,4" Margin="0,0,4,0" Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                Foreground="{StaticResource GruvFg}">
                            <ui:SymbolIcon Symbol="PanelLeft20" FontSize="15" />
                        </Button>

                        <!-- 2. 🍔 햄버거 메뉴 버튼 (텍스트 없이 아이콘만) -->
                        <Button Grid.Column="1" ToolTip="{DynamicResource Tip_Menu}" Click="OnHamburgerMenuClick"
                                Padding="6,4" Margin="0,0,6,0"
                                Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                Foreground="{StaticResource GruvFg}">
                            <Button.ContextMenu>
                                <ContextMenu Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}">
                                    <MenuItem Header="{DynamicResource Menu_NewNote}" Command="{Binding CreateNewNoteCommand}" InputGestureText="Ctrl+N" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="DocumentAdd20" Foreground="{StaticResource GruvAccentAqua}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_NewFolder}" Command="{Binding CreateNewFolderCommand}" InputGestureText="Ctrl+Shift+N" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="FolderAdd20" Foreground="{StaticResource GruvAccentYellow}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_Rename}" Command="{Binding RenameItemCommand}" CommandParameter="{Binding SelectedItem}" InputGestureText="F2" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Rename20" Foreground="{StaticResource GruvAccentOrange}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_Delete}" Command="{Binding DeleteSelectedItemCommand}" InputGestureText="Del" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Delete20" Foreground="#D9534F" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_Refresh}" Command="{Binding RefreshTreeCommand}" InputGestureText="F5" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowClockwise20" Foreground="{StaticResource GruvAccentGreen}" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator Background="{StaticResource GruvBorder}" />

                                    <MenuItem Header="{DynamicResource Menu_Find}" Click="OnMenuFindClick" InputGestureText="Ctrl+F" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Search20" Foreground="{StaticResource GruvFg}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_Replace}" Click="OnMenuReplaceClick" InputGestureText="Ctrl+H" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowRepeatAll20" Foreground="{StaticResource GruvAccentOrange}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_WordWrap}" Command="{Binding ToggleWordWrapCommand}" InputGestureText="Alt+Z" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextWrap20" Foreground="{StaticResource GruvFg}" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator Background="{StaticResource GruvBorder}" />

                                    <MenuItem Header="{DynamicResource Menu_OpenFolder}" Command="{Binding OpenInExplorerCommand}" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen20" Foreground="{StaticResource GruvAccentYellow}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_ChangeStorage}" Command="{Binding ChangeStorageLocationCommand}" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Settings20" Foreground="{StaticResource GruvAccentOrange}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_CloudGuide}" Click="OnCloudGuideClick" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="PhoneLaptop20" Foreground="{StaticResource GruvAccentAqua}" />
                                        </MenuItem.Icon>
                                    </MenuItem>

                                    <Separator Background="{StaticResource GruvBorder}" />

                                    <!-- 🌐 언어 선택 (Language) -->
                                    <MenuItem Header="{DynamicResource Menu_Language}" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Globe20" Foreground="{StaticResource GruvAccentAqua}" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{DynamicResource Menu_Lang_System}" Command="{Binding ChangeLanguageCommand}" CommandParameter="Auto"
                                                  IsCheckable="True" IsChecked="{Binding IsLangAuto}" Foreground="{StaticResource GruvFg}" />
                                        <MenuItem Header="{DynamicResource Menu_Lang_Ko}" Command="{Binding ChangeLanguageCommand}" CommandParameter="ko"
                                                  IsCheckable="True" IsChecked="{Binding IsLangKo}" Foreground="{StaticResource GruvFg}" />
                                        <MenuItem Header="{DynamicResource Menu_Lang_En}" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"
                                                  IsCheckable="True" IsChecked="{Binding IsLangEn}" Foreground="{StaticResource GruvFg}" />
                                    </MenuItem>

                                    <MenuItem Header="{DynamicResource Menu_ToggleSidebar}" Command="{Binding ToggleSidebarCommand}" InputGestureText="Ctrl+B" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="PanelLeft20" Foreground="{StaticResource GruvFgMuted}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Menu_About}" Click="OnAboutClick" Foreground="{StaticResource GruvFg}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Info20" Foreground="{StaticResource GruvAccentGreen}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <ui:SymbolIcon Symbol="Navigation20" FontSize="15" Foreground="{StaticResource GruvFg}" />
                        </Button>

                        <!-- 3. 메모 검색창 -->
                        <ui:TextBox Grid.Column="2" PlaceholderText="{DynamicResource Search_Placeholder}"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                    Background="{StaticResource GruvBg}"
                                    Foreground="{StaticResource GruvFg}"
                                    BorderBrush="{StaticResource GruvBorder}"
                                    Icon="{ui:SymbolIcon Search20}"
                                    ClearButtonEnabled="True"
                                    FontSize="12.5" />
                    </Grid>
                </Border>

                <!-- 1: 현재 생성 위치 상태 표시 & ROOT 바로가기 바 (여기로 드래그 드롭하면 ROOT로 이동 가능) -->
                <Border x:Name="RootBarBorder" Grid.Row="1" Background="{StaticResource GruvPanelBg}"
                        BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="5"
                        Padding="6,2,6,2" Margin="4,0,4,2"
                        AllowDrop="True"
                        DragOver="OnRootBarDragOver"
                        DragLeave="OnRootBarDragLeave"
                        Drop="OnRootBarDrop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ROOT 위치 버튼 (클릭 시 ROOT 선택 / 선택 해제) -->
                        <Button Grid.Column="0" Command="{Binding ClearTreeSelectionCommand}"
                                ToolTip="{DynamicResource Root_SelectTip}"
                                Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder20" FontSize="14" Foreground="{StaticResource GruvAccentYellow}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CurrentLocationDescription}" FontSize="12.5" Foreground="{StaticResource GruvFg}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- 폴더/메모가 선택되었을 때만 표시되는 [선택 해제] 버튼 -->
                        <Button Grid.Column="1" ToolTip="{DynamicResource Root_DeselectTip}"
                                Command="{Binding ClearTreeSelectionCommand}"
                                Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVis}}"
                                Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{StaticResource GruvFgMuted}" Margin="0,0,3,0" />
                                <TextBlock Text="{DynamicResource Root_Deselect}" FontSize="11" Foreground="{StaticResource GruvFgMuted}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2: 트리 뷰 컨트롤 (여백 클릭 시 선택 해제, 드래그 앤 드롭 지원, 트리 전용 단축키) -->
                <TreeView x:Name="TreePadView" Grid.Row="2" ItemsSource="{Binding RootItems}"
                          SelectedItemChanged="OnTreeViewSelectedItemChanged"
                          PreviewKeyDown="OnTreeViewPreviewKeyDown"
                          PreviewMouseDown="OnTreeViewPreviewMouseDown"
                          PreviewMouseLeftButtonDown="OnTreeViewPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnTreeViewPreviewMouseMove"
                          AllowDrop="True"
                          DragOver="OnTreeViewDragOver"
                          DragLeave="OnTreeViewDragLeave"
                          Drop="OnTreeViewDrop"
                          BorderThickness="0" Background="Transparent"
                          Padding="4,2">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{StaticResource GruvFg}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <EventSetter Event="MouseRightButtonDown" Handler="OnTreeViewItemMouseRightButtonDown" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- 🌟 부드러운 안티그래비티 Pill 라운딩 적용 🌟 -->
                                            <Border x:Name="HeaderBorder" Grid.Row="0"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="6"
                                                    Padding="4,3"
                                                    Margin="2,1"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 화살표 토글 버튼 (폴더일 때만 표시) -->
                                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                  Focusable="False"
                                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ClickMode="Press"
                                                                  Width="16" Height="16"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="{x:Type ToggleButton}">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                            <Border Background="Transparent" Width="16" Height="16">
                                                                                <Path x:Name="Arrow"
                                                                                      Data="M 4 2 L 10 7 L 4 12 Z"
                                                                                      Fill="{StaticResource GruvFgMuted}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      SnapsToDevicePixels="True" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90" CenterX="7" CenterY="7" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource GruvFg}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource GruvAccentOrange}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>

                                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- 🌲 하위 항목 영역 (은은한 세로 트리 인덴트 라인 포함) 🌲 -->
                                            <Grid Grid.Row="1" Margin="11,0,0,0">
                                                <Rectangle Width="1" HorizontalAlignment="Left" Margin="5,0,0,2"
                                                           Fill="{StaticResource GruvBorder}" Opacity="0.6"
                                                           SnapsToDevicePixels="True" />
                                                <ItemsPresenter x:Name="ItemsHost" Margin="6,0,0,0" />
                                            </Grid>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True" SourceName="HeaderBorder">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource GruvTabHoverBg}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource GruvSelectedPill}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#25D96B27" />
                                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource GruvAccentOrange}" />
                                                <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1.5" />
                                            </DataTrigger>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}">
                            <MenuItem Header="{DynamicResource Tree_NewNote}" Command="{Binding CreateNewNoteCommand}" InputGestureText="Ctrl+N" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DocumentAdd20" Foreground="{StaticResource GruvAccentAqua}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Tree_NewFolder}" Command="{Binding CreateNewFolderCommand}" InputGestureText="Ctrl+Shift+N" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="FolderAdd20" Foreground="{StaticResource GruvAccentYellow}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="{StaticResource GruvBorder}" />
                            <MenuItem Header="{DynamicResource Tree_NewRootNote}" Command="{Binding CreateRootNoteCommand}" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DocumentArrowRight20" Foreground="{StaticResource GruvAccentAqua}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Tree_NewRootFolder}" Command="{Binding CreateRootFolderCommand}" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen20" Foreground="{StaticResource GruvAccentYellow}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="{StaticResource GruvBorder}" />
                            <MenuItem Header="{DynamicResource Tree_ClearSelection}" Command="{Binding ClearTreeSelectionCommand}" InputGestureText="Esc" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DismissCircle20" Foreground="{StaticResource GruvFgMuted}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Tree_Refresh}" Command="{Binding RefreshTreeCommand}" InputGestureText="F5" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise20" Foreground="{StaticResource GruvAccentGreen}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="{StaticResource GruvBorder}" />
                            <MenuItem Header="{DynamicResource Tree_Rename}" Command="{Binding RenameItemCommand}" CommandParameter="{Binding SelectedItem}" InputGestureText="F2" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Rename20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Tree_Delete}" Command="{Binding DeleteSelectedItemCommand}" InputGestureText="Del" Foreground="{StaticResource GruvFg}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete20" Foreground="#AF2520" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>

            <!-- 분할 조절바 (GridSplitter) -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}" />

            <!-- 우측 패널 (탭 바 + 순수 텍스트 에디터) -->
            <Grid Grid.Column="2" Background="{StaticResource GruvBg}">
                <Grid.RowDefinitions>
                    <!-- 0: 탭 헤더 영역 -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: 에디터 보조 툴바 -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: 찾기 바 (Ctrl+F) -->
                    <RowDefinition Height="Auto" />
                    <!-- 3: 순수 텍스트 편집기 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 0: 탭 헤더 영역 -->
                <Border Grid.Row="0" Background="{StaticResource GruvTabBarBg}"
                        BorderBrush="{StaticResource GruvBorderStrong}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 좌측 탭 스크롤 버튼 -->
                        <Button x:Name="TabScrollLeftBtn" Grid.Column="0" Click="OnTabScrollLeftClick"
                                ToolTip="{DynamicResource Tab_PrevTip}"
                                Padding="4,6" Margin="2,0,0,0" Background="Transparent" BorderThickness="0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChevronLeft16" FontSize="12" Foreground="{StaticResource GruvAccentOrange}" />
                        </Button>

                        <!-- 탭 스크롤 뷰어 -->
                        <ScrollViewer x:Name="TabsScrollViewer" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnTabsScrollViewerScrollChanged"
                                      PreviewMouseWheel="OnTabsScrollViewerPreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NoteTabViewModel}">
                                        <Border Margin="3,4,3,0" CornerRadius="5,5,0,0" Cursor="Hand"
                                                MouseLeftButtonDown="OnTabItemMouseLeftButtonDown"
                                                MouseDown="OnTabItemMouseDown">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="{StaticResource GruvInactiveTabBg}" />
                                                    <Setter Property="BorderThickness" Value="1,1,1,1" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GruvBorder}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GruvActiveTabBg}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource GruvBorderStrong}" />
                                                            <Setter Property="BorderThickness" Value="1,0,1,0" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{StaticResource GruvTabHoverBg}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}">
                                                    <MenuItem Header="{DynamicResource Tab_Close}" InputGestureText="Ctrl+W" Command="{Binding CloseCommand}" Foreground="{StaticResource GruvFg}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Dismiss16" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource Tab_CloseOthers}"
                                                              Command="{Binding DataContext.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" Foreground="{StaticResource GruvFg}" />
                                                    <MenuItem Header="{DynamicResource Tab_CloseAll}"
                                                              Command="{Binding DataContext.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource GruvFg}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="3" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Background="{StaticResource GruvAccentOrange}" CornerRadius="3,3,0,0"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,5,8,6">
                                                    <ui:SymbolIcon Symbol="DocumentText16" FontSize="13" Foreground="{StaticResource GruvAccentAqua}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{StaticResource GruvFgMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource GruvFg}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- 탭 닫기 (X) 버튼 -->
                                                    <Button ToolTip="{DynamicResource Tab_CloseTip}" Command="{Binding CloseCommand}"
                                                            Padding="3,1" Margin="2,0,0,0" Background="Transparent" BorderThickness="0"
                                                            Cursor="Arrow">
                                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="{StaticResource GruvFgMuted}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 우측 탭 스크롤 버튼 -->
                        <Button x:Name="TabScrollRightBtn" Grid.Column="2" Click="OnTabScrollRightClick"
                                ToolTip="{DynamicResource Tab_NextTip}"
                                Padding="4,6" Margin="0,0,2,0" Background="Transparent" BorderThickness="0"
                                Visibility="Collapsed" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChevronRight16" FontSize="12" Foreground="{StaticResource GruvAccentOrange}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 1: 에디터 보조 툴바 -->
                <Border Grid.Row="1" Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}" BorderThickness="0,0,0,1"
                        Padding="16,6" Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 현재 활성 탭 경로 (사이드바 닫혔을 때는 펼치기 버튼 표시) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button ToolTip="{DynamicResource Tip_ExpandSidebar}" Command="{Binding ToggleSidebarCommand}"
                                    Visibility="{Binding IsSidebarVisible, Converter={StaticResource InverseBoolToVis}}"
                                    Padding="5,3" Margin="0,0,8,0" Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                    Foreground="{StaticResource GruvFg}">
                                <ui:SymbolIcon Symbol="PanelLeft20" FontSize="14" />
                            </Button>
                            <TextBlock Text="{Binding ActiveTab.RelativePath}"
                                       FontSize="12" Foreground="{StaticResource GruvFgMuted}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 에디터 옵션 버튼군 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button ToolTip="{DynamicResource Tip_Find}" Click="OnToggleFindBarClick"
                                    Padding="7,5" Margin="0,0,2,0" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource GruvFg}">
                                <ui:SymbolIcon Symbol="Search20" FontSize="15" />
                            </Button>

                            <Button ToolTip="{DynamicResource Tip_Replace}" Click="OnToggleReplaceBarClick"
                                    Padding="7,5" Margin="0,0,6,0" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource GruvFg}">
                                <ui:SymbolIcon Symbol="ArrowRepeatAll20" FontSize="15" />
                            </Button>

                            <Button ToolTip="{Binding WordWrapTooltip}" Command="{Binding ToggleWordWrapCommand}"
                                    Padding="7,5" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{StaticResource GruvBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WordWrap}" Value="True">
                                                <Setter Property="Background" Value="#25D96B27" />
                                                <Setter Property="BorderBrush" Value="{StaticResource GruvAccentOrange}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="TextWrap20" FontSize="15">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="{x:Type ui:SymbolIcon}">
                                            <Setter Property="Foreground" Value="{StaticResource GruvFgMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WordWrap}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource GruvAccentOrange}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Button>

                            <Separator Width="1" Height="14" Margin="2,0,6,0" Background="{StaticResource GruvBorder}" />

                            <ComboBox ItemsSource="{Binding AvailableFontSizes}"
                                      SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"
                                      ToolTip="{DynamicResource Tip_FontSize}"
                                      Width="82" Height="28" Padding="8,3,4,3"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      Background="{StaticResource GruvBg}"
                                      BorderBrush="{StaticResource GruvBorder}"
                                      Foreground="{StaticResource GruvFg}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2: 빠른 찾기 및 바꾸기 바 (Ctrl+F / Ctrl+H) -->
                <Border x:Name="FindBar" Grid.Row="2" Background="{StaticResource GruvPanelBg}"
                        BorderBrush="{StaticResource GruvBorder}" BorderThickness="0,0,0,1"
                        Padding="16,6" Visibility="Collapsed">
                    <StackPanel Orientation="Vertical">
                        <!-- 1행: 찾기 (Find) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ToggleReplaceBtn" Grid.Column="0" ToolTip="{DynamicResource Replace_ToggleTip}"
                                    Click="OnToggleReplaceRowClick"
                                    Padding="4,2" Margin="0,0,6,0" Background="Transparent" BorderThickness="0">
                                <ui:SymbolIcon x:Name="ToggleReplaceIcon" Symbol="ChevronRight16" FontSize="12" Foreground="{StaticResource GruvFgMuted}" />
                            </Button>

                            <TextBlock Grid.Column="1" Text="{DynamicResource Find_Label}" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource GruvFg}" />
                            <ui:TextBox x:Name="FindInputBox" Grid.Column="2" FontSize="12.5" Padding="6,2"
                                        Background="{StaticResource GruvBg}" Foreground="{StaticResource GruvFg}"
                                        BorderBrush="{StaticResource GruvBorder}"
                                        KeyDown="OnFindInputKeyDown" TextChanged="OnFindInputTextChanged" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button ToolTip="{DynamicResource Find_Prev}" Click="OnFindPreviousClick"
                                        Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                        Foreground="{StaticResource GruvFg}" Padding="6,3" Margin="0,0,4,0" FontSize="12">
                                    <ui:SymbolIcon Symbol="ArrowUp16" FontSize="12" />
                                </Button>
                                <Button ToolTip="{DynamicResource Find_Next}" Click="OnFindNextClick"
                                        Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                        Foreground="{StaticResource GruvFg}" Padding="6,3" Margin="0,0,4,0" FontSize="12">
                                    <ui:SymbolIcon Symbol="ArrowDown16" FontSize="12" />
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="FindStatusText" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{StaticResource GruvFgMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="5" Click="OnCloseFindBarClick" ToolTip="{DynamicResource Find_CloseTip}"
                                    Padding="4,2" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource GruvFg}">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- 2행: 바꾸기 (Replace) -->
                        <Grid x:Name="ReplaceRowGrid" Visibility="Collapsed" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="18" Margin="0,0,6,0" />

                            <TextBlock Grid.Column="1" Text="{DynamicResource Replace_Label}" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource GruvFg}" />
                            <ui:TextBox x:Name="ReplaceInputBox" Grid.Column="2" FontSize="12.5" Padding="6,2"
                                        Background="{StaticResource GruvBg}" Foreground="{StaticResource GruvFg}"
                                        BorderBrush="{StaticResource GruvBorder}"
                                        KeyDown="OnReplaceInputKeyDown" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Content="{DynamicResource Replace_Btn}" Click="OnReplaceCurrentClick" ToolTip="{DynamicResource Replace_CurrentTip}"
                                        Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                        Foreground="{StaticResource GruvFg}" Padding="8,3" Margin="0,0,4,0" FontSize="12" />
                                <Button Content="{DynamicResource Replace_AllBtn}" Click="OnReplaceAllClick" ToolTip="{DynamicResource Replace_AllTip}"
                                        Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}"
                                        Foreground="{StaticResource GruvFg}" Padding="8,3" Margin="0,0,4,0" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3: 메인 순수 텍스트 에디터 -->
                <Grid Grid.Row="3">
                    <TextBox x:Name="EditorTextBox"
                             Style="{StaticResource GruvPureEditorTextBoxStyle}"
                             Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVis}}"
                             Text="{Binding ActiveTab.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="{Binding WordWrap, Converter={StaticResource BoolToWrap}}"
                             FontSize="{Binding FontSize}"
                             FontFamily="Pretendard, Segoe UI Variable Text, 맑은 고딕, Malgun Gothic, sans-serif"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="28,20,28,28"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             SpellCheck.IsEnabled="False"
                             Cursor="IBeam"
                             TextChanged="OnEditorTextChanged"
                             SelectionChanged="OnEditorSelectionChanged"
                             PreviewKeyDown="OnEditorPreviewKeyDown"
                             PreviewMouseWheel="OnEditorPreviewMouseWheel"
                             ContextMenuOpening="OnEditorContextMenuOpening">
                        <TextBox.ContextMenu>
                            <ContextMenu Background="{StaticResource GruvBg}" BorderBrush="{StaticResource GruvBorder}" BorderThickness="1">
                                <ContextMenu.Resources>
                                    <Style TargetType="{x:Type ContextMenu}">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ContextMenu}">
                                                    <Border Background="{StaticResource GruvBg}"
                                                            BorderBrush="{StaticResource GruvBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="4,4"
                                                            SnapsToDevicePixels="True">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.14" Direction="270" Color="#42352B"/>
                                                        </Border.Effect>
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource GruvFg}"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="14,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type MenuItem}">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,1">
                                                        <Grid MinWidth="150">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{TemplateBinding Header}"
                                                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontWeight="Normal"/>
                                                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                                                       Foreground="{StaticResource GruvFgMuted}" FontSize="12" VerticalAlignment="Center" Margin="24,0,4,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GruvSelectedPill}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.38"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>

                                <MenuItem x:Name="MenuCopy" Header="{DynamicResource Edit_Copy}" InputGestureText="Ctrl+C"
                                          Command="ApplicationCommands.Copy"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem x:Name="MenuCut" Header="{DynamicResource Edit_Cut}" InputGestureText="Ctrl+X"
                                          Command="ApplicationCommands.Cut"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem x:Name="MenuSelectAll" Header="{DynamicResource Edit_SelectAll}" InputGestureText="Ctrl+A"
                                          Command="ApplicationCommands.SelectAll"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem x:Name="MenuPaste" Header="{DynamicResource Edit_Paste}" InputGestureText="Ctrl+V"
                                          Command="ApplicationCommands.Paste"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <!-- 모든 탭이 닫혔을 때의 빈 상태 안내 화면 (사이드바가 닫혀 있어도 좌측 상단에 펼치기 버튼 상시 보장) -->
                    <Grid Visibility="{Binding HasOpenTabs, Converter={StaticResource InverseBoolToVis}}">
                        <Button ToolTip="{DynamicResource Tip_ExpandSidebar}" Command="{Binding ToggleSidebarCommand}"
                                Visibility="{Binding IsSidebarVisible, Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0"
                                Padding="6,4" Background="{StaticResource GruvPanelBg}" BorderBrush="{StaticResource GruvBorder}"
                                Foreground="{StaticResource GruvFg}">
                            <ui:SymbolIcon Symbol="PanelLeft20" FontSize="15" />
                        </Button>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Notepad24" FontSize="48" Foreground="{StaticResource GruvBorderStrong}" Margin="0,0,0,16" />
                            <TextBlock Text="{DynamicResource Empty_Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GruvFg}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{DynamicResource Empty_Desc}"
                                       FontSize="13" Foreground="{StaticResource GruvFgMuted}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                            <Button Content="{DynamicResource Empty_NewNoteBtn}"
                                    Command="{Binding CreateNewNoteCommand}"
                                    HorizontalAlignment="Center"
                                    Padding="16,7" FontSize="13" FontWeight="Medium" Cursor="Hand"
                                    Background="{StaticResource GruvPanelBg}"
                                    BorderBrush="{StaticResource GruvBorderStrong}"
                                    Foreground="{StaticResource GruvFg}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 2: 하단 상태 표시줄 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource GruvBorder}" BorderThickness="0,1,0,0"
                Background="{StaticResource GruvPanelBg}" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 좌측: 저장 상태 인디케이터 & 저장소 요약 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Foreground="{StaticResource GruvAccentGreen}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{StaticResource GruvFg}" Margin="0,0,16,0" />
                    <TextBlock Text="{DynamicResource Status_StoragePath}" FontSize="11.5" Foreground="{StaticResource GruvFgMuted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding StorageDirectoryPath}" FontSize="11.5"
                               Foreground="{StaticResource GruvFgMuted}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                </StackPanel>

                <!-- 우측: 텍스트 정보 (줄바꿈 상태, UTF-8, 글자수, 줄 수, 커서 위치) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button ToolTip="{Binding WordWrapTooltip}" Command="{Binding ToggleWordWrapCommand}"
                            Padding="6,2" Margin="0,0,10,0" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TextWrap20" FontSize="12" Margin="0,0,4,0">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                        <Setter Property="Foreground" Value="{StaticResource GruvFgMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WordWrap}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GruvAccentOrange}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Text="{DynamicResource Status_WordWrap}" FontSize="11.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource GruvFgMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WordWrap}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GruvAccentOrange}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Height="12" Margin="0,0,12,0" Background="{StaticResource GruvBorder}" />

                    <TextBlock Text="{DynamicResource Status_UTF8}" FontSize="12" Foreground="{StaticResource GruvFgMuted}" Margin="0,0,14,0" />
                    <Separator Width="1" Height="12" Margin="0,0,14,0" Background="{StaticResource GruvBorder}" />
                    <TextBlock Text="{Binding CharCountText}" FontSize="12" Foreground="{StaticResource GruvFg}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CharCountNoSpacesText}" FontSize="11.5"
                               Foreground="{StaticResource GruvFgMuted}" Margin="0,0,14,0" />
                    <Separator Width="1" Height="12" Margin="0,0,14,0" Background="{StaticResource GruvBorder}" />
                    <TextBlock Text="{Binding LineCountText}" FontSize="12" Foreground="{StaticResource GruvFg}" Margin="0,0,14,0" />
                    <Separator Width="1" Height="12" Margin="0,0,14,0" Background="{StaticResource GruvBorder}" />
                    <TextBlock Text="{Binding CursorPositionText}" FontSize="12" Foreground="{StaticResource GruvFg}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
